---
type Props = {
  href: string;
  label: string;
  value: string;
  target?: string;
  rel?: string;
};

const { href, label, value, target, rel } = Astro.props;
---

<a
  href={href}
  target={target}
  rel={rel}
  class="flex items-center gap-3 rounded-xl border border-base-300 bg-base-200/70 px-4 py-3 transition hover:-translate-y-0.5 hover:border-primary/40 hover:bg-base-200"
>
  <span class="flex h-10 w-10 items-center justify-center rounded-full bg-base-300 text-lg text-primary">
    <slot name="icon" />
  </span>
  <div>
    <div class="text-sm uppercase tracking-wide text-base-content/60">{label}</div>
    <div class="font-semibold">{value}</div>
  </div>
</a>
