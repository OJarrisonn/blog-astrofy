---
import ContactCard from "@components/resume/ContactCard.astro";
import * as Fa from "react-icons/fa";
import * as Io from "react-icons/io5";

type Props = {
  contactEmail: string;
};

const { contactEmail } = Astro.props;
---

<div class="mb-10 grid gap-4 sm:grid-cols-2">
  <ContactCard
    href="https://github.com/nahharris"
    label="GitHub"
    value="github.com/nahharris"
    target="_blank"
  >
    <Fa.FaGithub slot="icon" />
  </ContactCard>
  <ContactCard
    href="https://www.linkedin.com/in/nahharrisonn"
    label="LinkedIn"
    value="linkedin.com/in/nahharrisonn"
    target="_blank"
  >
    <Fa.FaLinkedin slot="icon" />
  </ContactCard>
  <ContactCard
    href={`mailto:${contactEmail}`}
    label="Email"
    value={contactEmail}
  >
    <Io.IoMailOutline slot="icon" />
  </ContactCard>
  <ContactCard
    href="https://mastodon.social/@nahharris"
    label="Mastodon"
    value="mastodon.social/@nahharris"
    target="_blank"
    rel="me"
  >
    <Fa.FaMastodon slot="icon" />
  </ContactCard>
</div>
